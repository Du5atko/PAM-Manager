{
  "bundle_name": "12-mfa-cert-otp",
  "version": "1.0.0",
  "title": "Multi-Factor Authentication with Certificate + OTP/HOTP",
  "description": "Three-factor authentication combining smart card certificates, system password, and OTP for maximum security",
  "author": "PAM Manager v9.0",
  "category": "authentication",
  "security_level": "critical",
  "pam_services": ["login", "sshd"],
  "type": "Fragment",
  "platforms": {
    "debian_ubuntu": {
      "packages": ["libpam-pkcs11", "libpcsclite1", "libopensc6", "oathtool", "libpam-oath"],
      "package_manager": "apt"
    },
    "fedora_rhel": {
      "packages": ["pam_pkcs11", "pcsc-lite", "opensc", "oathtool", "pam-oath"],
      "package_manager": "dnf"
    },
    "alpine": {
      "packages": ["opensc", "oath-toolkit"],
      "package_manager": "apk"
    },
    "arch": {
      "packages": ["opensc", "oath-toolkit"],
      "package_manager": "pacman"
    }
  },
  "configuration": {
    "auth_stack": [
      "auth required pam_unix.so",
      "auth required pam_pkcs11.so",
      "auth required pam_oath.so usersfile=/etc/users.oath window=10"
    ]
  },
  "dependencies": {
    "system_requirements": [
      "Smart card reader hardware",
      "PKCS#11 middleware",
      "CA/CRL infrastructure",
      "Valid user certificates",
      "pam_pkcs11 properly configured"
    ],
    "pam_modules": ["pam_unix", "pam_pkcs11", "pam_oath"],
    "configuration_files": [
      "/etc/users.oath",
      "/etc/pam_pkcs11.conf",
      "/etc/ssl/certs/ca-certificates.crt"
    ],
    "hardware": [
      "USB Smart Card Reader",
      "Valid X.509 User Certificates",
      "Private keys on smart card"
    ]
  },
  "notes": {
    "authentication_factors": [
      "Something you know: System password",
      "Something you have: Smart card with certificate",
      "Something you have: Mobile authenticator (OTP)"
    ],
    "ssh_limitation": "Not suitable for SSH server remote access (card not present)",
    "use_case": "Local authentication, sensitive operations, high-security environments",
    "complexity": "High - requires certificate infrastructure and card reader"
  },
  "script_file": "12-mfa-cert-otp.msh",
  "created_at": "2026-08-16T00:00:00Z",
  "modified_at": "2026-08-16T00:00:00Z"
}
