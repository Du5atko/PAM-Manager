      "packages": [],
      "package_manager": "pacman"
    },
    "FreeBSD": {
      "packages": [
        "pam"
      ],
      "package_manager": "pkg"
    },
    "Generic": {
      "packages": [
        "pam"
      ],
      "package_manager": "generic"
    },
    "Fedora": {
      "packages": [],
      "package_manager": "dnf"
    }
  },
  "installation_script": "04-motd-userspecific.msh",
  "deployment_requirements": [
    "No additional packages required",
    "Standard PAM modules"
  ],
