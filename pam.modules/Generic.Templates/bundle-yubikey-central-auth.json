{
  "id": "bundle-yubikey-central-auth",
  "bundle_name": "YubiKey Central MFA",
  "version": "1.0.0",
  "title": "Centralized YubiKey FIDO/U2F MFA",
  "description": "Centralized administrator-managed YubiKey registration for easier key management and rotation",
  "category": "authentication",
  "security_level": "high",
  "pam_services": [
    "login",
    "sshd",
    "sudo"
  ],
  "type": "Bundle",
  "elements": [
    {
      "id": "element-yubikey-central-mfa",
      "import": "../Element.Templates/template.yubikey-central-mfa.json",
      "required": true
    }
  ],
  "services": [
    {
      "name": "login",
      "type": "standard",
      "config_file": "/etc/pam.d/login"
    },
    {
      "name": "sshd",
      "type": "standard",
      "config_file": "/etc/pam.d/sshd"
    }
  ],
  "platforms": {
    "Debian/Ubuntu": {
      "packages": [
        "libpam-u2f",
        "pamu2fcfg"
      ],
      "package_manager": "apt"
    },
    "RedHat/CentOS": {
      "packages": [
        "pam-u2f",
        "pamu2fcfg"
      ],
      "package_manager": "dnf"
    },
    "Alpine": {
      "packages": [
        "pam-u2f"
      ],
      "package_manager": "apk"
    },
    "Arch": {
      "packages": [
        "pam-u2f"
      ],
      "package_manager": "pacman"
    },
    "FreeBSD": {
      "packages": [
        "pam"
      ],
      "package_manager": "pkg"
    },
    "Generic": {
      "packages": [
        "pam"
      ],
      "package_manager": "generic"
    },
    "Fedora": {
      "packages": [
        "pam-u2f",
        "pamu2fcfg"
      ],
      "package_manager": "dnf"
    }
  },
  "installation_script": "02-yubikey-central.msh",
  "deployment_requirements": [
    "YubiKey devices for enrolled users",
    "Administrator access for enrollment",
    "/etc/u2f_mappings configuration"
  ],
  "management_tools": [
    "yubikey-central-register-user.sh",
    "yubikey-list-registered.sh",
    "yubikey-backup-mappings.sh"
  ],
  "configuration_files": [
    "/etc/u2f_mappings (permissions: 600)"
  ],
  "testing_steps": [
    "1. Admin registration: yubikey-central-register-user.sh username",
    "2. User login with password + YubiKey touch",
    "3. Verify /etc/u2f_mappings entry"
  ],
  "created": "2026-08-16T00:00:00Z",
  "modified": "2026-08-16T00:00:00Z"
}