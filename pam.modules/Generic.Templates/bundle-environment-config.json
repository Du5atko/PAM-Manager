{
  "id": "bundle-environment-config",
  "bundle_name": "Environment Configuration",
  "version": "1.0.0",
  "title": "Login Type Environment Variables",
  "description": "Set environment variables based on login origin for conditional shell behavior",
  "category": "session",
  "security_level": "low",
  "pam_services": [
    "login",
    "sshd"
  ],
  "type": "Bundle",
  "elements": [
    {
      "id": "element-environment-configuration",
      "import": "../Element.Templates/template.environment-configuration.json",
      "required": true
    }
  ],
  "services": [
    {
      "name": "login",
      "type": "standard",
      "config_file": "/etc/pam.d/login"
    },
    {
      "name": "sshd",
      "type": "standard",
      "config_file": "/etc/pam.d/sshd"
    }
  ],
  "platforms": {
    "Debian/Ubuntu": {
      "packages": [
        "libpam-modules"
      ],
      "package_manager": "apt"
    },
    "RedHat/CentOS": {
      "packages": [
        "pam"
      ],
      "package_manager": "dnf"
    },
    "Alpine": {
      "packages": [
        "pam"
      ],
      "package_manager": "apk"
    },
    "Arch": {
      "packages": [
        "pam"
      ],
      "package_manager": "pacman"
    },
    "FreeBSD": {
      "packages": [
        "pam"
      ],
      "package_manager": "pkg"
    },
    "Generic": {
      "packages": [
        "pam"
      ],
      "package_manager": "generic"
    },
    "Fedora": {
      "packages": [
        "pam"
      ],
      "package_manager": "dnf"
    }
  },
  "installation_script": "09-environment-login-type.msh",
  "deployment_requirements": [
    "Separate pam_env.conf files for different services",
    "Update /etc/pam.d/login and /etc/pam.d/sshd"
  ],
  "management_tools": [
    "check-login-type.sh",
    "setup-login-prompt.sh",
    "verify-pam-env.sh"
  ],
  "configuration_files": [
    "/etc/security/pam_env.local.conf",
    "/etc/security/pam_env.remote.conf"
  ],
  "testing_steps": [
    "1. Create pam_env.conf files",
    "2. Test local login: check-login-type.sh",
    "3. Test SSH login: check-login-type.sh"
  ],
  "created": "2026-08-16T00:00:00Z",
