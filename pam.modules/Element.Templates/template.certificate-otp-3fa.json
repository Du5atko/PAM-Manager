{
  "id": "element-certificate-otp-3fa",
  "name": "Certificate + OTP Three-Factor Authentication",
  "description": "Maximum security with smart card certificate + password + OTP for government/military systems",
  "category": "authentication",
  "security_level": "critical",
  "pam_services": [
    "login"
  ],
  "fragments": [
    {
      "module": "pam_unix",
      "interface": "auth",
      "config": {
        "sha512": true,
        "shadow": true
      },
      "control_flag": "required",
      "ordering": 1,
      "fragment_ref": "pam_unix-basic"
    },
    {
      "module": "pam_pkcs11",
      "interface": "auth",
      "config": {
        "pkcs11_module": "opensc"
      },
      "control_flag": "required",
      "ordering": 2,
      "fragment_ref": "pam_pkcs11-smartcard"
    },
    {
      "module": "pam_oath",
      "interface": "auth",
      "config": {
        "usersfile": "/etc/users.oath",
        "window": 10
      },
      "control_flag": "required",
      "ordering": 3,
      "fragment_ref": "pam_oath-otp"
    }
  ],
  "pam_configuration": {
    "auth": [
      "auth required pam_unix.so sha512 shadow",
      "auth required pam_pkcs11.so",
      "auth required pam_oath.so usersfile=/etc/users.oath window=10"
    ]
  },
  "packages": {
    "debian_ubuntu": [
      "libpam-pkcs11",
      "libpcsclite1",
      "libopensc6",
      "oathtool",
      "libpam-oath"
    ],
    "fedora_rhel": [
      "pam_pkcs11",
      "pcsc-lite",
      "opensc",
      "oathtool",
      "pam-oath"
    ],
    "alpine": [
      "opensc",
      "oath-toolkit"
    ],
    "arch": [
      "opensc",
      "oath-toolkit"
    ]
  },
  "configuration_files": [
    "/etc/pam_pkcs11.conf (certificate validation)",
    "/etc/users.oath (OTP secrets, permissions: 600)"
  ],
  "authentication_factors": {
    "factor1": "Something you know: System password",
    "factor2": "Something you have: Smart card with certificate",
    "factor3": "Something you have: Mobile device with OTP app"
  },
  "hardware_requirements": [
    "USB Smart Card Reader",
    "Smart cards with X.509 certificates",
    "Private keys on cards (non-extractable)",
    "Phone with authenticator app"
  ],
  "infrastructure_requirements": [
    "Certificate Authority (CA)",
    "PKI certificate management",
    "CRL/OCSP support",
    "Card reader driver installation",
    "PCSC daemon (pcscd)"
  ],
  "deployment_requirements": [
    "Complex PKI infrastructure setup (weeks/months)",
    "Trained IT staff",
    "High implementation cost",
    "Ongoing certificate management",
    "Hardware maintenance"
  ],
  "management_tools": [
    "test-smartcard.sh (detect card reader)",
    "cert-otp-enroll.sh (enroll user)"
  ],
  "limitations": [
    "Local authentication ONLY (not for SSH remote)",
    "Requires physical card reader",
    "Complex infrastructure",
    "High cost",
    "Ongoing certificate renewals",
    "User training required"
  ],
  "use_cases": [
    "Military and government systems",
    "Financial institutions",
    "Critical infrastructure protection",
    "Defense contractors",
    "Top-secret data access"
  ],
  "bundle_source": "12-mfa-cert-otp",
  "notes": "CRITICAL: Enterprise/government only. Most complex to setup. Requires dedicated PKI team. Highest security available.",
  "testing_steps": [
    "1. Setup PCSC daemon: systemctl start pcscd",
    "2. Test smartcard detection: test-smartcard.sh",
